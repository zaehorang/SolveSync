# Required only when building SolveSync from source.
# Release ZIP users do not need an env file because these public identifiers are
# embedded in the compiled extension JavaScript during packaging.
# Replace the placeholders with the GitHub App used by the build.
# Never put a client secret in this project.
VITE_GITHUB_APP_CLIENT_ID=replace-with-your-github-app-client-id
VITE_GITHUB_APP_SLUG=replace-with-your-github-app-slug
