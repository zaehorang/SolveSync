# Public GitHub App configuration. Do not put a client secret in this project.
VITE_GITHUB_APP_CLIENT_ID=replace-with-your-github-app-client-id
VITE_GITHUB_APP_SLUG=replace-with-your-github-app-slug

# Live E2E 캡처용 SWEA 계정. 값은 `.env`에만 넣는다 — `.gitignore`에 있다.
#
# SWEA만 필요하다. SWEA의 SESSION 쿠키는 만료 기한 없이 발급되는 진짜 session
# cookie라 브라우저 프로세스가 끝나면 사라진다. Verification Profile에 남길
# 방법이 없어 실행마다 다시 로그인해야 한다.
#
# LeetCode·Programmers는 여기에 넣지 않는다. 쿠키가 디스크에 남아 재로그인이
# 필요 없고, LeetCode는 Cloudflare Turnstile이 붙어 있어 자동 로그인 시도
# 자체가 bot 판정 위험이다. 두 곳은 `npm run e2e:login`으로 한 번만 로그인한다.
#
# 비워 두면 자동 로그인을 건너뛰고 사람이 직접 로그인할 때까지 기다린다.
E2E_SWEA_ID=
E2E_SWEA_PASSWORD=
