#!/usr/bin/env python3
"""Git pre-commit gate. core.hooksPath = harness/hooks로 설치된다.

경로가 상대 경로라 각 worktree가 자기 루트를 기준으로 해석하고 자기 branch에
체크아웃된 hook을 실행한다. git은 hook을 working tree의 최상위에서 실행하므로
아래의 상대 경로는 worktree 기준이다.

되돌릴 수 없는 저장소 보호 규칙만 커밋 시점에 확인한다. typecheck·Vitest·build는
PR을 만들기 직전인 pre-push에서 실행한다.
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

import policy  # noqa: E402


def run(args: list[str], capture: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(args, capture_output=capture, text=True)


def fail(message: str) -> None:
    print(f"pre-commit: {message}", file=sys.stderr)
    sys.exit(1)


def git(*args: str) -> str:
    """답을 얻지 못하면 커밋을 거부하는 git 호출.

    branch를 판정할 수 없는 gate가 branch를 안전하다고 가정해서는 안 된다.
    """
    result = run(["git", *args])
    if result.returncode != 0:
        fail(f"git {' '.join(args)} 실패: {result.stderr.strip()}")
    return result.stdout.strip()


def main() -> None:
    branch = git("rev-parse", "--abbrev-ref", "HEAD")
    if branch == "main":
        fail("main에서는 커밋할 수 없습니다. 작업 branch를 먼저 만드세요 (CLAUDE.md).")

    branch_problem = policy.check_branch_name(branch)
    if branch_problem:
        fail(branch_problem)

    # git이 주는 경로는 이 hook의 cwd(= working tree 최상위) 기준이다.
    git_dirs = git("rev-parse", "--git-dir", "--git-common-dir").splitlines()
    if len(git_dirs) != 2:
        fail("git rev-parse가 --git-dir와 --git-common-dir를 돌려주지 않았습니다.")
    isolation_problem = policy.check_worktree_isolation(*git_dirs)
    if isolation_problem:
        fail(isolation_problem)

    # `-z`로 받는다. quotePath 기본값에서 비ASCII 경로는 C-style로 quote되어 돌아오고
    # 그러면 금지 경로 prefix 검사를 그냥 지나간다.
    def staged_paths(diff_filter: str) -> list[str]:
        argv = ("diff", "--cached", "--name-only", "-z", f"--diff-filter={diff_filter}")
        return [p for p in git(*argv).split("\0") if p]

    # 삭제(D)까지 포함한 전체 목록. 삭제만 담은 commit도 정상이고, ACMR로만
    # 세면 그런 commit이 "변경 없음"으로 막혀 우회 말고는 길이 없다.
    touched = staged_paths("ACMRD")
    if not touched:
        fail("staged 변경이 없습니다.")

    # 반면 금지 경로 검사는 tree에 남는 파일만 본다. 지워지는 경로는 금지
    # 위치에 있어도 사라지는 중이므로 막을 이유가 없다. 아래 secret 검사는
    # 이 목록이 아니라 diff 본문을 보므로 이 필터의 영향을 받지 않는다.
    staged = staged_paths("ACMR")

    for problem in policy.check_staged_paths(staged):
        fail(problem)

    diff = git("diff", "--cached", "-U0")
    secrets = policy.scan_secrets(diff)
    if secrets:
        labels = ", ".join(sorted({label for label, _ in secrets}))
        fail(f"staged 변경에 secret으로 보이는 값이 있습니다 ({labels}). 커밋 전에 제거하세요.")


if __name__ == "__main__":
    main()
