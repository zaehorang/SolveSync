{
  "name": "solvesync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "build": "npm run build:extension && npm run build:content && npm run build:swea-bridge && npm run verify:build",
    "build:extension": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build:swea-bridge": "vite build --config vite.swea-bridge.config.ts",
    "package:chrome": "npm run build && node scripts/package_chrome.mjs",
    "verify:build": "node scripts/verify_extension_build.mjs",
    "e2e": "playwright test",
    "e2e:capture": "playwright test e2e/capture --headed",
    "e2e:capture:swea": "E2E_CAPTURE_SWEA=1 playwright test e2e/capture/captureSweaSession.spec.ts --headed",
    "e2e:login": "E2E_LOGIN=1 playwright test e2e/capture/login.spec.ts --headed",
    "e2e:contract": "E2E_CONTRACT=1 playwright test e2e/contract.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
